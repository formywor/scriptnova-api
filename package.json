{
  "name": "nebula-api",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": { "node": "24.x" },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "model:data": "node scripts/model-data.mjs",
    "model:review": "python model/cli.py review",
    "model:train": "node scripts/model-data.mjs train",
    "model:serve": "python model/serve.py",
    "check": "node --check index.js && node --check lib/app.mjs && node --check lib/firebase.mjs && node --test test/*.test.mjs",
    "check:sdk": "node --no-experimental-require-module scripts/check-firebase.mjs",
    "check:model": "node scripts/check-model.mjs",
    "postinstall": "node scripts/check-model.mjs && node --no-experimental-require-module scripts/check-firebase.mjs"
  },
  "dependencies": { "firebase-admin": "14.5.0" },
  "overrides": { "jwks-rsa": { "jose": "4.15.9" } }
}
