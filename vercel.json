{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 120,
        "includeFiles": [
          "nebula-rules.json"
        ],
        "excludeFiles": [
          "model-assets/**",
          "node_modules/onnxruntime-node/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
