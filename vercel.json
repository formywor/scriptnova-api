{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 120,
        "includeFiles": [
          "nebula-rules.json",
          "model-assets/nebula-v4-experimental-1-01.part",
          "model-assets/nebula-v4-experimental-1-02.part",
          "model-assets/nebula-v4-experimental-1-03.part",
          "model-assets/nebula-v4-experimental-1-04.part",
          "model-assets/nebula-v4-experimental-1-05.part",
          "model-assets/nebula-v4-experimental-1-06.part",
          "model-assets/release.json",
          "model-assets/nebula-pilot.json",
          "model-assets/nebula-v1-lite/**",
          "model-assets/nebula-v2-1/**",
          "node_modules/onnxruntime-node/bin/napi-v6/linux/x64/*.node",
          "node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime.so.1"
        ],
        "excludeFiles": [
          "node_modules/onnxruntime-node/bin/napi-v6/win32/**",
          "node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
          "node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
          "node_modules/onnxruntime-node/bin/napi-v6/linux/x64/*providers*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
