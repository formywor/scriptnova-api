# Add these to the existing API project's environment variables in Vercel.
# Generate different random values, each at least 32 characters.
MOVIE_ADMIN_KEY=
MOVIE_GIFT_KEY=
MOVIE_DEFAULT_URL=https://scriptnovaa.com/movie.mkv
MOVIE_ALLOWED_ORIGINS=https://scriptnovaa.com,https://www.scriptnovaa.com
# Reuses existing FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL,
# FIREBASE_PRIVATE_KEY, and FIREBASE_DATABASE_URL from your API.
