# Server configuration only. Do not copy this file into the website repository.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Generate a stable, random secret of at least 32 characters for hashed rate-limit keys.
NEBULA_RATE_LIMIT_SECRET=
NEBULA_ALLOWED_ORIGINS=https://scriptnovaa.com,https://www.scriptnovaa.com
# Master switch for consent-controlled contribution collection; false disables it.
NEBULA_TRAINING_ENABLED=true
# Private model service /chat URL, hosted separately from this Vercel API.
# Keep empty until a trained checkpoint passes your quality review.
NEBULA_MODEL_URL=
# Use the same random secret (32+ characters) on the API and model service.
NEBULA_MODEL_KEY=
NEBULA_MODEL_NAME=nebula
# embedded serves the pinned experimental V4 checkpoint inside this Node API.
NEBULA_MODEL_MODE=embedded
# Optional private owner instructions, appended to nebula-rules.json.
# Keep credentials and other secrets out of prompts, even private prompts.
NEBULA_OWNER_INSTRUCTIONS=
# Teacher keys are used by local model/cli.py only, never the public website.
NEBULA_TEACHER_KEY=
# Optional path to your Python environment for scripts/model-data.mjs train.
NEBULA_PYTHON=python

# Firebase web app configuration (intentionally public, never service-account secrets).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# After custom Hosting/DNS/OAuth setup, use auth.scriptnovaa.com here.
# Until then, keep the working share-browser-7091c.firebaseapp.com value in Vercel.
FIREBASE_WEB_APP_ID=
# Enable the same providers in Firebase Authentication before enabling them here.
NEBULA_AUTH_EMAIL=true
NEBULA_AUTH_GOOGLE=true
NEBULA_AUTH_APPLE=false
NEBULA_AUTH_PHONE=false

# Private training coordination. Disabled until private storage and worker secrets are configured.
# Bucket name only, without gs://. Reuses the Firebase server service account.
NEBULA_RESEARCH_ENABLED=false
NEBULA_CHECKPOINT_BUCKET=
# Two DIFFERENT random secrets, at least 32 characters. Never put these in source or website code.
NEBULA_TRAINER_TOKEN=
NEBULA_EVALUATOR_TOKEN=

# Hugging Face private model repository; takes precedence over the optional GCS bucket.
NEBULA_HF_REPO=iiidevv/nebula-research
NEBULA_HF_TOKEN=

# Optional third-party answer reviews, disabled until configured. Server only.
NEBULA_REVIEW_ENABLED=false
NEBULA_REVIEW_API_KEY=
NEBULA_REVIEW_MODEL=

# Optional second reviewer. Existing GROQ_API_KEY also works as a fallback.
NEBULA_REVIEW_GROQ_API_KEY=
NEBULA_REVIEW_GROQ_MODEL=openai/gpt-oss-20b

# Nebula Ultra (server-side only). Falls back to GROQ_API_KEY, then NEBULA_REVIEW_GROQ_API_KEY.
NEBULA_ULTRA_API_KEY=
NEBULA_ULTRA_MODEL=openai/gpt-oss-120b
# Disabled experimental artifacts are checked only when explicitly requested.
NEBULA_VALIDATE_TRAINING_MODELS=false
# Nebula Ultra cloud tools (optional; keep secrets server-side)
# Web search: Brave Search API key
NEBULA_SEARCH_API_KEY=
# Separate Google OAuth web client; enable Gmail API and gmail.send consent
NEBULA_GOOGLE_CLIENT_ID=
NEBULA_GOOGLE_CLIENT_SECRET=
# Exactly 32 random bytes encoded as base64. Keep stable across deployments.
NEBULA_CONNECTION_ENCRYPTION_KEY=
# Durable delayed delivery through Upstash QStash
QSTASH_TOKEN=
NEBULA_QSTASH_URL=https://qstash.upstash.io
# A separate random secret of at least 32 characters
NEBULA_SCHEDULE_WORKER_SECRET=
# Enable after queue configuration. Google is needed only for email delivery.
NEBULA_CLOUD_ENABLED=false
# Legacy NEBULA_SCHEDULE_ENABLED is still accepted if NEBULA_CLOUD_ENABLED is absent.
NEBULA_PUBLIC_API_URL=https://api.scriptnovaa.com
NEBULA_PUBLIC_SITE_URL=https://scriptnovaa.com

# Devices API-generated voice (keys stay on the API only).
# Defaults to Groq when NEBULA_ULTRA_API_KEY or GROQ_API_KEY is configured.
# NEBULA_TTS_PROVIDER=groq
# NEBULA_TTS_API_KEY=
# NEBULA_TTS_VOICES=[{"id":"troy","label":"Troy"},{"id":"hannah","label":"Hannah"}]
# Alternative: NEBULA_TTS_PROVIDER=elevenlabs with an approved voice list.
# ELEVENLABS_API_KEY=
# Glasses discovery stays disabled until actual hardware/protocol review.
# NEBULA_GLASSES_PROTOCOL_VERIFIED=false
# NEBULA_GLASSES_PROTOCOL_JSON=

# Owner-only V-D2; keys stay server-side.
NEBULA_VD2_INVITES_ENABLED=false
NEBULA_VD2_ULTRA_BRIDGE=false
# NEBULA_OWNER_UID=your-verified-owner-firebase-uid
# NEBULA_VD2_URL=https://your-private-worker.example/generate
# NEBULA_VD2_TOKEN=strong-random-server-only-token
NEBULA_ENABLE_LEGACY_MODELS=true
# NEBULA_LOAD_TEST_TARGETS=https://your-authorized-site.example/status
# NEBULA_LEGACY_URL=https://your-private-worker.example/chat
# NEBULA_LEGACY_KEY=strong-random-server-only-token-at-least-32-characters
