# Server configuration only. Do not copy this file into the website repository.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Generate a stable, random secret of at least 32 characters for hashed rate-limit keys.
NEBULA_RATE_LIMIT_SECRET=
NEBULA_ALLOWED_ORIGINS=https://scriptnovaa.com,https://www.scriptnovaa.com
# Leave off until the database and consent-controlled collection are ready.
NEBULA_TRAINING_ENABLED=false
# Your future model server. Leave empty while building the model.
NEBULA_MODEL_URL=
NEBULA_MODEL_KEY=
NEBULA_MODEL_NAME=nebula

# Firebase web app configuration (intentionally public, never service-account secrets).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Enable the same providers in Firebase Authentication before enabling them here.
NEBULA_AUTH_EMAIL=true
NEBULA_AUTH_GOOGLE=true
NEBULA_AUTH_APPLE=false
NEBULA_AUTH_PHONE=false
